{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "declaration": true,
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "@utils/*": ["./SPA/utils/*"],
      "@components/*": ["./SPA/components/*"]
    }
  },
  "include": ["SPA/**/*.ts", "vite.config.ts"]
}